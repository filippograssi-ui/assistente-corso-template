# Copia questo file in .env.local (in locale) oppure incolla le stesse variabili
# su Vercel → Settings → Environment Variables. Compila solo quello che ti serve:
# senza nessuna chiave l'app funziona lo stesso, mancano solo le parti "intelligenti".

# --- Lezione 2: l'intelligenza (riassunti, suggerimenti, notizie, cattura) ---
ANTHROPIC_API_KEY=

# --- Lezione 3: il database (Supabase → Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Lezione 4: WhatsApp (Meta for Developers) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_USER_NUMBER=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_BRIEFING=briefing_giornaliero
CRON_SECRET=

# --- Lezione 5: il lucchetto (password d'ingresso) ---
DASHBOARD_PASSWORD=
AUTH_SECRET=

# --- Facoltativi ---
# Google Calendar: credenziali OAuth da Google Cloud Console, con redirect URI
# https://TUO-SITO.vercel.app/api/google-calendar/callback (o http://localhost:3000/... in locale)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# USER_TIMEZONE=Europe/Rome
